# 复制为 .env 后按需修改

# 镜像名（deploy.sh 会把这个镜像传到 VPS）
IMAGE=qt-showcase:latest

# 只用 HTTP 时对外端口
HTTP_PORT=80

# 启用 HTTPS 时的域名（需提前解析到 VPS）
DOMAIN=

# 构建时的下载源。国内网络可改为：
# REGISTRY=docker.1ms.run
# AQT_BASE=https://mirrors.ustc.edu.cn/qtproject
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
REGISTRY=docker.io
AQT_BASE=https://download.qt.io
PIP_INDEX_URL=https://pypi.org/simple
