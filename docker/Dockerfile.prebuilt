# 只打包运行时镜像：直接使用本机 scripts/build-wasm.sh 编好的 dist/，不在容器里重新编译。
# 构建上下文是 dist/，nginx 配置通过额外上下文传入：
#   docker build -f docker/Dockerfile.prebuilt --build-context conf=docker -t qt-showcase:latest dist
ARG REGISTRY=docker.io
FROM ${REGISTRY}/library/nginx:1.27-alpine
COPY --from=conf nginx.conf /etc/nginx/conf.d/default.conf
COPY . /usr/share/nginx/html/
RUN H=/usr/share/nginx/html/demo/topology \
 && sed -i "s/__WASM_SIZE__/$(stat -c%s $H/topology.wasm)/" $H/index.html \
 && find /usr/share/nginx/html -type f \
        \( -name '*.wasm' -o -name '*.js' -o -name '*.html' -o -name '*.css' -o -name '*.svg' -o -name '*.json' \) \
        -exec gzip -9 -k {} \;
EXPOSE 80
